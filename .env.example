# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                  # development | production
APP_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── MariaDB ───────────────────────────────────────────────────────────────────
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=ragsystem
MARIADB_USER=ragsystem
MARIADB_PASSWORD=change-me-mariadb-password
MARIADB_ROOT_PASSWORD=change-me-root-password

# Async DSN (used by SQLAlchemy)
DATABASE_URL=mysql+aiomysql://ragsystem:change-me-mariadb-password@mariadb:3306/ragsystem

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=bge-m3

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_RETRIEVAL_TOP_K=5
RAG_RERANK_TOP_N=3
QDRANT_VECTOR_SIZE=1024               # bge-m3 output dimension

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/data/uploads
DATA_DIR=/app/data

# ── Seed Admin ────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_ADMIN_USERNAME=admin
